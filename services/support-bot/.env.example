# --- Discord (required) ---
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_application_id     # for /support slash-command registration
DISCORD_GUILD_ID=                         # optional: guild-scoped (instant) registration
MODERATION_GUILD_ID=                      # optional: enables cross-channel-spam auto-ban

# --- Local LLM (OpenAI-compatible /v1/chat/completions) ---
LOCAL_LLM_BASE_URL=http://localhost:8000  # no trailing /v1
LOCAL_LLM_MODEL=your-served-model-name    # required
LOCAL_LLM_API_KEY=                        # optional; many local servers need none
LOCAL_LLM_MAX_TOKENS=2048

# --- Access control ---
# Comma-separated Discord UIDs granted ADMIN (GitHub code-write + reviews). Everyone
# else is SUPPORT (read-only, redacted output). Maintainers only.
SUPPORT_BOT_ADMIN_DISCORD_IDS=
LEAD_DEVELOPER_DISCORD_ID=                # pinged when the bot takes a side-effecting action

# --- GitHub ---
GITHUB_TOKEN=your_github_pat
GITHUB_OWNER=caesarakalaeii
GITHUB_BOT_LOGIN=                         # bot's GitHub login; required to close bot-authored issues

# --- Repository checkouts (read-tool jail roots) ---
ALL_CHAT_REPO_PATH=/repos/all-chat
ALL_CHAT_EXTENSION_REPO_PATH=/repos/all-chat-extension

# --- Grafana (optional; enables Loki/Prometheus tools when both are set) ---
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_LOKI_DATASOURCE=Loki
GRAFANA_PROM_DATASOURCE=Prometheus

# --- Kubernetes (read-only) ---
KUBE_NAMESPACE=allchat

# --- Database (bot memory; optional — bot runs without it) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=allchat
DATABASE_PASSWORD=
DATABASE_NAME=allchat

# --- Runtime ---
PORT=8094
GIN_MODE=debug
LOG_LEVEL=info

# --- Agent loop tuning (optional) ---
SUPPORT_BOT_MAX_ITERATIONS=16
SUPPORT_BOT_PER_CALL_TIMEOUT=120s
SUPPORT_BOT_OVERALL_TIMEOUT=6m
SUPPORT_BOT_MAX_PARALLEL_TOOLS=6
