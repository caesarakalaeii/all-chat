# Build and test tooling (typescript, vitest) lives in devDependencies, so `npm ci`
# must install it even when the ambient NODE_ENV is "production" — npm otherwise
# infers `omit=dev` from that variable and silently skips them, leaving `npx tsc`
# and `npm test` to fail with "command not found".
#
# Setting `omit` to null here only clears the default: the runtime stage of the Dockerfile
# passes `--omit=dev` explicitly, and a command-line flag still overrides this.
omit=null
