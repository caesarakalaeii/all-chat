# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# YouTube Listener API
YOUTUBE_LISTENER_URL=http://localhost:8086

# Update interval in milliseconds (default: 10 minutes)
STATUS_UPDATE_INTERVAL=600000

# Optional: Grafana dashboard URL for interactive visualization
# Example: https://grafana.example.com/d/dashboard-uid/dashboard-name
GRAFANA_PANEL_URL=
