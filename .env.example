# ==============================================
# All-Chat Environment Configuration
# ==============================================

# Twitch OAuth (REQUIRED for Phase 1)
# Register app at: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback

# Twitch IRC Bot (Required for Phase 3 - Twitch Listener)
# Get OAuth token from: https://twitchapps.com/tmi/
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_BOT_OAUTH=oauth:your_oauth_token_here

# YouTube API (Required for Phase 4 - YouTube Listener)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in your Google Cloud project
YOUTUBE_CLIENT_ID=your_youtube_client_id_here.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your_youtube_client_secret_here
YOUTUBE_REDIRECT_URL=http://localhost:8080/api/v1/auth/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key

# TikTok API (BETA - TikTok Listener)
# Get from: https://developers.tiktok.com/
# Note: TikTok uses "client_key" terminology instead of "client_id"
# Note: Chat listener uses unofficial TikTok-Live-Connector (official API not yet available)
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URL=http://localhost:8080/api/v1/auth/tiktok/callback

# Kick OAuth (Kick Listener)
# Register app at: https://dev.kick.com (or https://docs.kick.com)
# Note: Kick uses OAuth 2.1 with PKCE (Proof Key for Code Exchange)
KICK_CLIENT_ID=your_kick_client_id_here
KICK_CLIENT_SECRET=your_kick_client_secret_here
KICK_REDIRECT_URL=http://localhost:8080/api/v1/auth/kick/callback

# JWT Secret (REQUIRED - Generate with: openssl rand -base64 32)
JWT_SECRET=dev-secret-change-in-production
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Database (Docker Compose defaults - change for production)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=allchat
DATABASE_PASSWORD=allchat_dev_password
DATABASE_NAME=allchat

# Redis (Docker Compose defaults)
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Settings
LOG_LEVEL=info
APP_VERSION=0.1.0

# CORS (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# WebSocket Overlay Security
# Comma-separated list; leave blank or use "*" to allow all origins
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
