# ==============================================
# All-Chat Environment Configuration
# ==============================================

# Twitch OAuth (REQUIRED for Phase 1)
# Register app at: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Twitch IRC Bot (Required for Phase 3 - Twitch Listener)
# Get OAuth token from: https://twitchapps.com/tmi/
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_BOT_OAUTH=oauth:your_oauth_token_here

# YouTube API (Required for Phase 4 - YouTube Listener)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in your Google Cloud project
YOUTUBE_CLIENT_ID=your_youtube_client_id_here.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your_youtube_client_secret_here
YOUTUBE_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key

# TikTok (BETA - TikTok Listener)
# Note: TikTok works via username only (no OAuth required)
# Note: Chat listener uses unofficial TikTok-Live-Connector library (official API not yet available)

# Kick OAuth (Kick Listener)
# Register app at: https://dev.kick.com (or https://docs.kick.com)
# Note: Kick uses OAuth 2.1 with PKCE (Proof Key for Code Exchange)
KICK_CLIENT_ID=your_kick_client_id_here
KICK_CLIENT_SECRET=your_kick_client_secret_here

# JWT Secret (REQUIRED - Generate with: openssl rand -base64 32)
JWT_SECRET=dev-secret-change-in-production
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Database (Docker Compose defaults - change for production)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=allchat
DATABASE_PASSWORD=allchat_dev_password
DATABASE_NAME=allchat

# Redis (Docker Compose defaults)
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Settings
LOG_LEVEL=info
APP_VERSION=0.1.0

# Frontend URL (used to generate OAuth redirect URIs)
FRONTEND_URL=http://localhost:3000

# CORS (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# WebSocket Overlay Security
# Comma-separated list; leave blank or use "*" to allow all origins
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Internal Service Communication
MESSAGE_PROCESSOR_URL=http://message-processor:8087
MESSAGE_PROCESSOR_API_KEY=dev-mock-key

# Message Processor Settings
# Maximum age of messages to process (in seconds, default: 60)
# Messages older than this will be ignored to prevent showing stale messages
MESSAGE_AGE_CUTOFF_SECONDS=60

# ==============================================
# YouTube Listener - Hybrid Detection & Quota Management
# ==============================================

# Feature flag to enable hybrid detection (status check + full detection)
ENABLE_HYBRID_DETECTION=true

# Global daily quota limit (default: 10000 units/day from YouTube)
YOUTUBE_GLOBAL_DAILY_QUOTA=10000

# Per-tier quota limits (units per channel per day)
YOUTUBE_HIGH_TIER_QUOTA=200
YOUTUBE_STANDARD_TIER_QUOTA=100
YOUTUBE_LOW_TIER_QUOTA=50

# Detection intervals per tier
YOUTUBE_HIGH_TIER_INTERVAL=30s
YOUTUBE_STANDARD_TIER_INTERVAL=2m
YOUTUBE_LOW_TIER_INTERVAL=10m

# Backoff configuration
YOUTUBE_GENTLE_BACKOFF_MULTIPLIER=1.2
YOUTUBE_GENTLE_BACKOFF_CAP=2.0
YOUTUBE_AGGRESSIVE_BACKOFF_MULTIPLIER=2.0
YOUTUBE_AGGRESSIVE_BACKOFF_CAP=60.0

# Activity thresholds
YOUTUBE_HIGH_TIER_DURATION=24h      # Stay in high tier for 24h after going live
YOUTUBE_DEMOTION_THRESHOLD=168h     # Demote if no stream for 7 days (168 hours)
YOUTUBE_RECENT_ACTIVITY_WINDOW=24h  # Consider channel "active" if live in last 24h

# Detection fallback thresholds
YOUTUBE_STATUS_CHECK_FAILURE_THRESHOLD=3  # Fallback to full detection after N failures
YOUTUBE_OFFLINE_CACHE_CLEAR_THRESHOLD=3   # Clear cached video ID after N offline checks

# ==============================================
# TikTok Listener - Live Detection & Backoff
# ==============================================

# Status check cache TTL (prevents rapid duplicate checks)
TIKTOK_STATUS_CHECK_CACHE_TTL_MS=10000  # 10 seconds

# Polling interval (how often to check the pool of offline channels)
TIKTOK_POLLER_INTERVAL_MS=30000  # 30 seconds

# Offline backoff configuration
TIKTOK_BASE_OFFLINE_BACKOFF_MS=60000   # Start: 1 minute for offline users
TIKTOK_MAX_OFFLINE_BACKOFF_MS=600000   # Max: 10 minutes between checks

# Error backoff configuration (network/API errors)
TIKTOK_ERROR_BACKOFF_MS=2000           # Start: 2 seconds for errors
TIKTOK_MAX_ERROR_BACKOFF_MS=300000     # Max: 5 minutes for errors

# ==============================================
# Discord Quota Monitor Bot
# ==============================================

# Discord Bot Token (Required for Discord bot)
# Create bot at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Channel ID where quota updates will be posted (Required)
# Enable Developer Mode in Discord settings, right-click channel → Copy ID
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# How often to post periodic quota status updates (in milliseconds)
# Default: 3600000 (1 hour)
STATUS_UPDATE_INTERVAL=3600000
