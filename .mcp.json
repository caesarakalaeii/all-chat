{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "nix",
      "args": [
        "develop",
        "-c",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--executable-path",
        "${PLAYWRIGHT_CHROMIUM_PATH}"
      ],
      "cwd": "${ALL_CHAT_FRONTEND_DIR}"
    }
  }
}
