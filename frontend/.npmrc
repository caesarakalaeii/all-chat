# Install devDependencies even when NODE_ENV=production is set in the ambient
# environment. The test and type-check toolchain (vitest, typescript, husky)
# lives in devDependencies, so `npm ci` must not omit them or commands like
# `npx vitest` and `npx tsc --noEmit` fail with "command not found".
#
# Production images install with an explicit `npm ci --omit=dev`, which still
# takes precedence over this setting.
include[]=prod
include[]=dev
include[]=optional
