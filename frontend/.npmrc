# Install devDependencies even when NODE_ENV=production is set in the ambient
# environment. The test and type-check toolchain (vitest, typescript, husky)
# lives in devDependencies, so `npm ci` must not omit them or commands like
# `npx vitest` and `npx tsc --noEmit` fail with "command not found".
#
# This must be `omit=` (an explicit empty list) and NOT `include[]=dev` or
# `production=false`. npm applies `include` after `omit`, so both of those
# spellings override an explicit `--omit=dev` given on the command line, which
# silently broke the `npm audit --audit-level=high --omit=dev` job in
# .github/workflows/security-scan.yml: it started auditing devDependencies and
# failed on dev-only advisories. An empty `omit` cancels only the value that
# NODE_ENV=production implies, while `--omit=dev` on the CLI still wins.
#
# npm prints "invalid config omit=" for the empty value. That warning is
# cosmetic and the resolved value is correct (verified with `npm config get
# omit`, with and without --omit=dev); the alternatives above are silent but
# functionally wrong here.
omit=

# Some CI/dev containers use an Alpine userland (so /usr/bin/ldd is the musl
# shim) while running a glibc-linked Node, e.g. Node installed from nix. npm's
# libc detection trusts that shim, installs the *-musl native bindings, and the
# glibc Node then cannot dlopen them -- vitest dies at startup with
# "Cannot find native binding". Pinning glibc here makes npm fetch the bindings
# that actually match the Node binary, and scripts/fix-native-bindings.mjs then
# puts them where the napi-rs loaders look.
#
# The production image is unaffected. frontend/Dockerfile installs dependencies
# only in its node:26-alpine "deps" stage, which copies just package.json and
# package-lock.json -- not this file -- so that genuine musl host still resolves
# musl bindings. The later "builder" stage does copy this file via `COPY frontend/ .`
# but never runs an install (only `npm run build`), and `libc` affects dependency
# resolution at install time only.
libc=glibc
