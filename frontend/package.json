{
  "name": "allchat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run copy:monaco",
    "dev": "next dev -p 3000",
    "generate:themes": "node scripts/generate-bundled-themes.mjs",
    "copy:monaco": "node scripts/copy-monaco.mjs",
    "prebuild": "npm run copy:monaco",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:themes": "playwright test theme-contrast --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "analyze": "ANALYZE=true npm run build",
    "postinstall": "test -f scripts/fix-native-bindings.mjs && node scripts/fix-native-bindings.mjs || true",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.29.0",
    "next": "^16.3.0",
    "react": "^19.2.7",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "nextBundleAnalysis": {
    "budget": 20480,
    "budgetPercentIncreaseRed": 20,
    "minimumChangeThreshold": 0,
    "showDetails": true
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "dompurify": "^3.4.13",
    "monaco-editor": "0.55.1",
    "tsconfck": {
      "typescript": "$typescript"
    },
    "@rolldown/plugin-babel": {
      "@babel/plugin-transform-runtime": "^7.29.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^5.3.0",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-tailwindcss": "^4.1.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.16.2",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
