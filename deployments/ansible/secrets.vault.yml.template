---
# Ansible Vault Template for All-Chat Secrets
#
# This is a TEMPLATE file showing what variables need to be defined.
# To use this:
# 1. Copy this file: cp secrets.vault.yml.template secrets.vault.yml
# 2. Fill in your actual values in secrets.vault.yml
# 3. Encrypt the file: ansible-vault encrypt secrets.vault.yml
# 4. Use password when running playbook: ansible-playbook -i inventory.yml playbook.yml --ask-vault-pass
#
# To edit encrypted vault: ansible-vault edit secrets.vault.yml
# To decrypt: ansible-vault decrypt secrets.vault.yml

# =============================================================================
# DATABASE CREDENTIALS
# =============================================================================
# PostgreSQL password for the 'allchat' database user
postgres_password: "CHANGE_ME_allchat_dev_password"

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Secret key for signing JWT tokens (use a long random string in production)
# Generate with: openssl rand -base64 32
jwt_secret: "CHANGE_ME_your-secret-jwt-key-here"

# JWT token expiry in hours (default: 24)
jwt_expiry_hours: "24"

# =============================================================================
# TWITCH INTEGRATION
# =============================================================================
# Twitch OAuth Application Credentials
# Get these from: https://dev.twitch.tv/console/apps
twitch_client_id: "CHANGE_ME_your_twitch_client_id"
twitch_client_secret: "CHANGE_ME_your_twitch_client_secret"

# Twitch IRC Bot Credentials
# Bot username (lowercase)
twitch_bot_username: "CHANGE_ME_your_bot_username"

# Bot OAuth token (get from https://twitchapps.com/tmi/)
# Format: oauth:abcdef123456...
twitch_bot_oauth: "CHANGE_ME_oauth:your_oauth_token_here"

# OAuth callback URL (adjust if deploying to different domain)
twitch_redirect_url: "http://localhost:8080/api/v1/auth/callback"

# =============================================================================
# YOUTUBE INTEGRATION
# =============================================================================
# YouTube OAuth Application Credentials
# Get these from: https://console.developers.google.com/
youtube_client_id: "CHANGE_ME_your_youtube_client_id"
youtube_client_secret: "CHANGE_ME_your_youtube_client_secret"

# YouTube OAuth callback URL
youtube_redirect_url: "http://localhost:8080/api/v1/auth/youtube/callback"

# YouTube API Key (optional, for public API calls)
youtube_api_key: "CHANGE_ME_your_youtube_api_key_optional"

# =============================================================================
# INTERNAL SERVICE AUTHENTICATION
# =============================================================================
# Shared key used by overlay-manager to call the message processor mock endpoint
message_processor_api_key: "CHANGE_ME_generate_a_strong_key"

# =============================================================================
# OPTIONAL: ADDITIONAL PLATFORM CREDENTIALS
# =============================================================================
# Kick API credentials (when implemented)
# kick_client_id: "your_kick_client_id"
# kick_client_secret: "your_kick_client_secret"

# TikTok API credentials (when implemented)
# tiktok_client_id: "your_tiktok_client_id"
# tiktok_client_secret: "your_tiktok_client_secret"

# =============================================================================
# CONFIGURATION OPTIONS
# =============================================================================
# Cluster configuration
cluster_name: "allchat"
k3d_version: "v5.6.0"
kubectl_version: "v1.28.0"

# Port mappings
registry_port: 5000
api_port: 6443
http_port: 8080
https_port: 8443

# Application configuration
log_level: "info"
cors_origin: "http://localhost:3000"
polling_interval_ms: "2000"
quota_limit_daily: "10000"

# Database configuration
database_host: "postgres"
database_port: "5432"
database_name: "allchat"
database_user: "allchat"

# Redis configuration
redis_host: "redis"
redis_port: "6379"
