{
  "dashboard": {
    "title": "Sharding & Rebalancing Overview",
    "tags": ["allchat", "sharding", "rebalancing"],
    "timezone": "browser",
    "refresh": "30s",
    "editable": true,
    "graphTooltip": 1,
    "schemaVersion": 38,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Load Imbalance Ratio",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "shard_imbalance_ratio",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 0.5,
                  "color": "yellow"
                },
                {
                  "value": 0.7,
                  "color": "red"
                }
              ]
            },
            "unit": "short",
            "decimals": 2,
            "mappings": []
          }
        },
        "options": {
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "description": "Current load imbalance ratio. Values >0.7 trigger rebalancing.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Healthy Pods",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "shard_healthy_pods",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 1,
                  "color": "green"
                }
              ]
            },
            "unit": "short",
            "mappings": []
          }
        },
        "options": {
          "orientation": "auto",
          "textMode": "value",
          "colorMode": "background"
        },
        "description": "Number of healthy listener pods",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Failed Pods",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 9,
          "y": 0
        },
        "targets": [
          {
            "expr": "shard_failed_pods",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "red"
                }
              ]
            },
            "unit": "short",
            "mappings": []
          }
        },
        "options": {
          "orientation": "auto",
          "textMode": "value",
          "colorMode": "background"
        },
        "description": "Number of failed listener pods",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 4,
        "type": "heatmap",
        "title": "Channel Distribution by Platform: Pod × Platform",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "expr": "sum(shard_channel_count) by (pod_id, platform)",
            "refId": "A",
            "legendFormat": "{{ pod_id }} - {{ platform }}",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "options": {
          "calculate": true,
          "cellGap": 2,
          "color": {
            "mode": "scheme",
            "scheme": "Spectral"
          },
          "yAxis": {
            "axisLabel": "Pod ID",
            "decimals": 0
          },
          "xAxis": {
            "axisLabel": "Platform"
          }
        },
        "description": "Heatmap showing channel distribution across pods by platform. Darker colors indicate higher channel counts.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 5,
        "type": "heatmap",
        "title": "Channel Distribution Over Time: Pod × Time",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        },
        "targets": [
          {
            "expr": "shard_channel_count",
            "refId": "A",
            "legendFormat": "{{ pod_id }}",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "options": {
          "calculate": true,
          "cellGap": 2,
          "color": {
            "mode": "scheme",
            "scheme": "Spectral"
          },
          "yAxis": {
            "axisLabel": "Pod ID",
            "decimals": 0
          }
        },
        "description": "Heatmap showing channel distribution over time. Visualizes rebalancing effects as load shifts between pods.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 6,
        "type": "graph",
        "title": "Rebalancing Events Timeline",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        },
        "targets": [
          {
            "expr": "increase(shard_rebalancing_total[5m])",
            "refId": "A",
            "legendFormat": "Rebalancing Rate",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "xaxis": {
          "mode": "time",
          "show": true
        },
        "yaxes": [
          {
            "format": "short",
            "label": "Rebalancing Count",
            "show": true
          },
          {
            "show": true
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "points": false,
        "pointradius": 2,
        "bars": false,
        "stack": false,
        "percentage": false,
        "legend": {
          "show": true,
          "alignAsTable": false,
          "avg": false,
          "current": false,
          "max": false,
          "min": false,
          "rightSide": false,
          "total": false,
          "values": false
        },
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        },
        "annotations": {
          "list": [
            {
              "name": "Rebalancing Triggers",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "ALERTS{alertname=\"ShardLoadImbalance\"}",
              "titleFormat": "Imbalance Alert",
              "textFormat": "Ratio: {{ $value }}",
              "iconColor": "red",
              "enable": true
            }
          ]
        },
        "description": "Timeline of rebalancing operations with alert markers showing when imbalance alerts fired.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 7,
        "type": "table",
        "title": "Recent Migration Events",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        },
        "targets": [
          {
            "expr": "shard_migration_total",
            "refId": "A",
            "format": "table",
            "instant": true,
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "status": "Status",
                "reason": "Reason",
                "Value": "Count"
              }
            }
          }
        ],
        "options": {
          "showHeader": true,
          "footer": {
            "show": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            }
          }
        },
        "description": "Table showing migration event counts by status and reason.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 8,
        "type": "graph",
        "title": "Per-Pod Load Scores",
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 20
        },
        "targets": [
          {
            "expr": "shard_pod_load_score",
            "refId": "A",
            "legendFormat": "{{ pod_id }}",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "xaxis": {
          "mode": "time",
          "show": true
        },
        "yaxes": [
          {
            "format": "short",
            "label": "Load Score",
            "show": true
          },
          {
            "show": true
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "points": false,
        "pointradius": 2,
        "bars": false,
        "stack": false,
        "percentage": false,
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true,
          "min": false,
          "rightSide": true,
          "total": false,
          "values": true
        },
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        },
        "description": "Composite load score for each pod (70% message rate + 30% channel count). Used by coordinator for rebalancing decisions.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      }
    ]
  }
}
