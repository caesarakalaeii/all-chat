{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // tsc type-checks only. scripts/build.mjs (esbuild) owns emit and source
    // maps: the shipped .sdPlugin folder has no node_modules, so it needs a
    // bundle with the SDK inlined, not transpiled modules with bare imports.
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
