test/contract/schema/capture
test/contract/schema/contract
test/contract/dual-listener/dual-listener

# Output of the go coverage tool
*.out
coverage.out
coverage.html

# Go workspace file
go.work

# Dependency directories
vendor/

# Build artifacts and binaries
# LSP and build cache directories

@*/
shared/pkg

# Service binaries
services/*/bin/
services/*/auth-service
services/*/overlay-manager
services/*/emote-service
services/*/api-gateway
services/*/twitch-listener
services/*/youtube-listener
services/*/message-processor
services/*/main
# Compiled command binaries (go build output in cmd/ subdirs)
services/auth-service/cmd/key-rotator/key-rotator
services/youtube-listener/cmd/token_backfill/token_backfill

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build output
/bin/
/dist/
/build/

# Documentation clones / references
.docs/

# Font files (too large for git)
docs/overlay-themes/custom-fonts/
*.ttf
*.otf
*.woff
*.woff2
# Exception: OG image font (required for build-time rendering)
!frontend/public/fonts/Barlow-Bold.ttf

# Vendored Monaco Editor assets (16 MB, regenerated from node_modules at build
# time by frontend/scripts/copy-monaco.mjs — see ADR-0040)
frontend/public/monaco/

# Agent instruction files generated by `next dev` (Next 16.3+ writes these from
# node_modules/next/dist/server/lib/generate-agent-files.js on every dev boot).
# They are upstream-authored, not ours — frontend/CLAUDE.md in particular would
# be auto-loaded into every Claude Code session in this repo.
frontend/AGENTS.md
frontend/CLAUDE.md

# Node modules (for frontend)
node_modules/
/web/node_modules/
/web/dist/
/web/build/
/web/.svelte-kit/

# Logs
*.log
logs/

# Database
*.db
*.sqlite

# Temporary files
tmp/
temp/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc

.resources

# Ansible Vault - Keep secrets encrypted and never commit plaintext!
deployments/ansible/secrets.vault.yml
deployments/ansible/.vault_pass
*.vault.yml
!*.vault.yml.template

# Test scripts
test/twitch-chat-test/test_twitch_chat.py

# Debug and checkpoint files
DEBUG_CHECKPOINT.md
CHECKPOINT.md
.playwright-mcp/

# MCP configuration (may contain secrets)
.mcp.json

# Screenshots and images (keep in docs/ only)
/*.png
/*.jpg
/*.jpeg
/*.gif

# Temporary status/tracing documentation
/*_COMPLETE.md
/*_STATUS.md
/*_FIX_*.md
TRACING_IMPLEMENTATION_STATUS.md
DISTRIBUTED_TRACING_COMPLETE.md

# Marketing / outreach (private, never commit)
docs/marketing/

# Sub-repo symlinks (managed via .planning/config.json sub_repos)
/caesar-deployment

# Personal/local artifacts not part of the project
.claude/projects/
.claude/scheduled_tasks.lock
package-lock.artillery.json
post-save.yml
